# Copy to .env for local development. Never commit .env.
# With either value empty, setup offers only typed names and the site never contacts Google.

# Google sign-in client (README, "Google classes"). Needs the read-only Sheets scope and this site's origin.
VITE_GOOGLE_CLIENT_ID=
# The spreadsheet holding every class: QuestRush's sheet, with its classrooms and students tabs.
VITE_ROSTER_SHEET_ID=
